# Copy to .env.local and fill in. .env.local is git-ignored; never commit real values.
# Only NEXT_PUBLIC_ variables reach the browser. Everything else stays on the server.

# ── Required ─────────────────────────────────────────────────────────────────

# Gemini: roadmap generation, lessons and the tutor. https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Supabase: auth and persistence. Project settings → API.
NEXT_PUBLIC_PROJECT_COURSESSUPABASE_URL=
NEXT_PUBLIC_PROJECT_COURSESSUPABASE_ANON_KEY=
# Server only. Bypasses Row Level Security; see src/lib/supabaseAdmin.ts.
SUPABASE_SERVICE_ROLE_KEY=

# ── Optional ─────────────────────────────────────────────────────────────────

# Google sign-in. Falls back to the production client ID, which only accepts
# localhost:3000 and codechad.dev as redirect URIs. See src/lib/googleAuth.ts.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Canonical site URL for metadata, sitemap and robots. Defaults to https://www.codechad.dev.
NEXT_PUBLIC_SITE_URL=

# Google Search Console verification token. Omitted from the page when empty.
GOOGLE_SITE_VERIFICATION=

# Stripe. Billing stays hidden, and its routes answer 503, until the secret key and
# price ID are both set. Full setup: docs/payments.md.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
